# syntax=docker/dockerfile:1.7

# ctrace is built on Ubuntu 22.04 so that the archive runs on its glibc and on every newer
# distribution: a binary only needs a glibc at least as old as the one it was linked against.
# Its own toolchain is too old for the project (C++20 <format> needs GCC 13, CMake >= 3.28), so
# newer ones are installed alongside; the libstdc++ they bring is shipped in the archive's lib/.
FROM ubuntu:22.04 AS base

ARG DEBIAN_FRONTEND=noninteractive
ARG LLVM_VERSION=20
ARG GCC_VERSION=13

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    gnupg \
    software-properties-common \
    build-essential \
    ninja-build \
    git \
    tar \
    patchelf \
    python3-venv \
    && add-apt-repository -y ppa:ubuntu-toolchain-r/test \
    && apt-get update && apt-get install -y --no-install-recommends \
    gcc-${GCC_VERSION} \
    g++-${GCC_VERSION} \
    && rm -rf /var/lib/apt/lists/*

ENV CC=gcc-${GCC_VERSION} CXX=g++-${GCC_VERSION}

COPY scripts/ci/install-llvm-apt.sh /usr/local/bin/install-llvm-apt.sh
RUN install-llvm-apt.sh ${LLVM_VERSION} \
    && rm -rf /var/lib/apt/lists/*

# Ubuntu 22.04's CMake is 3.22.
ARG CMAKE_VERSION=3.31.6
RUN python3 -m venv /opt/build-tools \
    && /opt/build-tools/bin/pip install --no-cache-dir cmake==${CMAKE_VERSION}
ENV PATH=/opt/build-tools/bin:${PATH}

WORKDIR /repo

# coretrace-python-analyzer is compiled on Rocky Linux 9 (glibc 2.34), older than Ubuntu 22.04,
# so that the archive also runs on RHEL 9 and its rebuilds: everything else in it already needs
# no more than glibc 2.34. The analyzer version is the one cmake/pythonAnalyzer.cmake pins.
FROM rockylinux/rockylinux:9 AS python-analyzer

ARG NUITKA_VERSION=4.2.2
RUN dnf install -y python3.12 python3.12-devel gcc git zlib-devel \
    && dnf clean all \
    && python3.12 -m venv /opt/nuitka \
    && /opt/nuitka/bin/pip install --no-cache-dir nuitka==${NUITKA_VERSION} patchelf
ENV PATH=/opt/nuitka/bin:${PATH}

COPY cmake/pythonAnalyzer.cmake scripts/build-python-analyzer.sh /src/
RUN set -eux; \
    tag="$(sed -n 's/^set(CORETRACE_PYTHON_ANALYZER_TAG "\([^"]*\)".*/\1/p' /src/pythonAnalyzer.cmake)"; \
    test -n "${tag}"; \
    git clone --quiet --depth 1 --branch "${tag}" \
        https://github.com/CoreTrace/coretrace-python-analyzer.git /analyzer; \
    PYTHON=/opt/nuitka/bin/python sh /src/build-python-analyzer.sh /analyzer /out

FROM base AS builder

ARG LLVM_VERSION=20
ARG VERSION=dev

COPY . /repo
COPY --from=python-analyzer /out/coretrace_python.dist /prebuilt/coretrace-python-analyzer

RUN cmake -S . -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DUSE_THREAD_SANITIZER=OFF \
        -DUSE_ADDRESS_SANITIZER=OFF \
        -DCLANG_LINK_CLANG_DYLIB=ON \
        -DCORETRACE_VERSION_OVERRIDE="${VERSION}" \
        -DLLVM_DIR=/usr/lib/llvm-${LLVM_VERSION}/lib/cmake/llvm \
        -DClang_DIR=/usr/lib/llvm-${LLVM_VERSION}/lib/cmake/clang \
        -DENABLE_PYTHON_ANALYZER=ON \
        -DCORETRACE_PYTHON_ANALYZER_PREBUILT=/prebuilt/coretrace-python-analyzer \
    && cmake --build build -j"$(nproc)" \
    && ./build/ctrace --version >/dev/null \
    && ./build/ctrace -h >/dev/null

FROM builder AS packager

ARG VERSION=dev
ARG TARGETARCH
ARG PROJECT_NAME=coretrace
ARG BINARY_NAME=ctrace

SHELL ["/bin/bash", "-o", "pipefail", "-c"]
RUN set -eux; \
    case "${TARGETARCH}" in \
      amd64) arch_label="amd64" ;; \
      arm64) arch_label="arm64" ;; \
      *) echo "unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    package_name="${PROJECT_NAME}-${VERSION}-linux-${arch_label}"; \
    staging="/staging/${package_name}"; \
    \
    # Install via CMake (binary in bin/, shared libs in lib/, config in share/) \
    cmake --install build --prefix "${staging}" --strip; \
    \
    # Patch RPATH on bundled shared libs so they resolve each other \
    find "${staging}/lib" -name '*.so*' -type f -exec \
        patchelf --set-rpath '$ORIGIN' {} \; ; \
    \
    # Verify all shared libraries resolve via RPATH alone (no LD_LIBRARY_PATH) \
    ldd "${staging}/bin/${BINARY_NAME}" | { ! grep 'not found'; }; \
    \
    # Add metadata files \
    install -m 0644 /repo/README.md "${staging}/README.md"; \
    install -m 0644 /repo/LICENSE "${staging}/LICENSE"; \
    \
    # Create archive and checksum \
    mkdir -p /out; \
    tar -C /staging -czf "/out/${package_name}.tar.gz" "${package_name}"; \
    (cd /out && sha256sum "${package_name}.tar.gz" > "${package_name}.tar.gz.sha256"); \
    rm -rf /staging

# The archive as users receive it, unpacked once and then run on the oldest distributions it
# targets (RHEL 9, Ubuntu 22.04, Debian 12) and on the newest, each image bare: no compiler, no
# LLVM, no Python. The Python analyzer is checked first; then only the C library's headers are
# added, as any C build environment has them, and a C source is analyzed with no clang
# installed. Each stage depends on the previous one, so the artifacts are only exported when all
# of them pass.

FROM base AS unpacked

COPY --from=packager /out/ /out/
RUN mkdir /opt/coretrace \
    && tar -xzf /out/*.tar.gz -C /opt/coretrace --strip-components=1

FROM ubuntu:22.04 AS verify-ubuntu-22.04

COPY --from=unpacked /out/ /out/
COPY --from=unpacked /opt/coretrace/ /opt/coretrace/
COPY tests/ /tests/
RUN set -eux; \
    if command -v python3; then echo "the verification image must not have Python" >&2; exit 1; fi; \
    sh /tests/python/check-installed.sh /opt/coretrace /tmp/check-installed; \
    apt-get update && apt-get install -y --no-install-recommends libc6-dev; \
    if command -v clang || ls /usr/lib/llvm-*; then echo "the verification image must not have clang" >&2; exit 1; fi; \
    sh /tests/release/check-c-analysis.sh /opt/coretrace /tmp/check-c

FROM debian:12 AS verify-debian-12

COPY --from=verify-ubuntu-22.04 /out/ /out/
COPY --from=unpacked /opt/coretrace/ /opt/coretrace/
COPY tests/ /tests/
RUN set -eux; \
    sh /tests/python/check-installed.sh /opt/coretrace /tmp/check-installed; \
    apt-get update && apt-get install -y --no-install-recommends libc6-dev; \
    sh /tests/release/check-c-analysis.sh /opt/coretrace /tmp/check-c

FROM rockylinux/rockylinux:9 AS verify-rhel-9

COPY --from=verify-debian-12 /out/ /out/
COPY --from=unpacked /opt/coretrace/ /opt/coretrace/
COPY tests/ /tests/
RUN set -eux; \
    sh /tests/python/check-installed.sh /opt/coretrace /tmp/check-installed; \
    dnf install -y glibc-devel; \
    sh /tests/release/check-c-analysis.sh /opt/coretrace /tmp/check-c

FROM ubuntu:24.04 AS verify-ubuntu-24.04

COPY --from=verify-rhel-9 /out/ /out/
COPY --from=unpacked /opt/coretrace/ /opt/coretrace/
COPY tests/ /tests/
RUN set -eux; \
    sh /tests/python/check-installed.sh /opt/coretrace /tmp/check-installed; \
    apt-get update && apt-get install -y --no-install-recommends libc6-dev; \
    sh /tests/release/check-c-analysis.sh /opt/coretrace /tmp/check-c

FROM scratch AS artifacts

COPY --from=verify-ubuntu-24.04 /out/ /
